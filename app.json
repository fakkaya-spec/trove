{
  "expo": {
    "name": "BoatCheck",
    "slug": "marincheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1D33",
    "primaryColor": "#C9A227",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kosko.boatcheck",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kosko.boatcheck",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1D33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0B1D33"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera is used to photograph the boat's condition, gauges and equipment for your inspection records.",
          "photosPermission": "Photo library access lets you attach existing photos to inspection records.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier is used to show less repetitive ads in the classic checklist mode."
        }
      ],
      "expo-localization",
      "expo-sqlite"
    ]
  }
}
